# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# helius.dev > API Keys
HELIUS_API_KEY=

# X developer portal > your app > Keys and tokens > OAuth 2.0 Client ID and Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match the callback URL you enter in the X app settings exactly
X_REDIRECT_URI=https://YOUR-SITE.vercel.app/api/x/callback

# SPYx token mint address on Solana (copy it from Solscan or pump.fun)
SPYX_MINT=

# Any long random text. Protects the cron endpoint.
CRON_SECRET=

# Optional: CoinGecko demo API key (works without one, but with lower limits)
COINGECKO_API_KEY=
